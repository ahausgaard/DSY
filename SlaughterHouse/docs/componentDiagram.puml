@startuml c4-l3-component
title SlaughterHouse Server - C4 Level 3: Components (Traceability)

hide stereotype
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle<<container>> {
  BackgroundColor #438DD5
  FontColor #FFFFFF
}
skinparam database<<container>> {
  BackgroundColor #438DD5
  FontColor #FFFFFF
}
skinparam rectangle<<component>> {
  BackgroundColor #85BBF0
  FontColor #000000
}
skinparam rectangle<<boundary>> {
  BackgroundColor transparent
  BorderColor #AAAAAA
  BorderStyle dashed
  FontColor #AAAAAA
}

rectangle "**Recall Client**\n[Java console app]\n\n//Asks which animals are in a product and//\n//which products an animal ended up in//" <<container>> as recallClient

rectangle "SlaughterHouse Server [Java, Spring Boot, gRPC :9090]" <<boundary>> {

  rectangle "**Traceability gRPC Endpoint**\n[gRPC service, extends\nTraceabilityServiceImplBase]\n\n//Implements GetAnimal, GetProduct,//\n//GetAnimalsInProduct, GetProductsForAnimal;//\n//maps not found to NOT_FOUND status//" <<component>> as endpoint

  rectangle "**Message Mapper**\n[Java class]\n\n//Converts domain objects to proto messages//\n//(AnimalReply, ProductReply, id lists)//" <<component>> as mapper

  rectangle "**Traceability Service**\n[Spring @Service]\n\n//Looks up animals and products, and walks//\n//Product -> Tray -> Part -> Animal both ways//\n//to find registration numbers and products//" <<component>> as service

  rectangle "**Animal Repository**\n[Spring Data JPA]\n\n//Finds an animal, and the animals whose//\n//parts ended up in a given product//" <<component>> as animalRepo

  rectangle "**Product Repository**\n[Spring Data JPA]\n\n//Finds a product, and the products drawn//\n//from trays holding a given animal's parts//" <<component>> as productRepo
}

database "**Database**\n[PostgreSQL 18]\n\n//animal, part, tray, product,//\n//product_tray tables//" <<container>> as db

' Keep the two repositories side by side
animalRepo -[hidden]right- productRepo

recallClient -[#0B4884,bold]down-> endpoint : calls RPCs\n//[gRPC, protobuf]//
endpoint     -[#0B4884,bold]down-> service  : delegates to
endpoint     -[#0B4884,bold]right-> mapper  : builds replies with
service      -[#0B4884,bold]down-> animalRepo  : reads animals
service      -[#0B4884,bold]down-> productRepo : reads products
animalRepo   -[#0B4884,bold]down-> db : queries\n//[JDBC]//
productRepo  -[#0B4884,bold]down-> db : queries\n//[JDBC]//

@enduml
